  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web",
    "export:ios": "expo export --platform ios",
    "ios:check": "node scripts/ios-preflight.mjs",
    "lint": "expo lint",
    "test:release": "node --test tests/*.test.mjs",
