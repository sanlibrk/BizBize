# Mobile/web client: public API address only. Server secrets never belong here.
EXPO_PUBLIC_API_URL=http://localhost:3001
# On Android emulator use http://10.0.2.2:3001 during development.
# On a real device use the HTTPS address of your own API.
BIZBIZE_IOS_BUNDLE_IDENTIFIER=com.example.bizbize
EAS_PROJECT_ID=YOUR_EAS_PROJECT_UUID

# Set only for the free serverless pilot: lower payloads and 15-second foreground sync.
# EXPO_PUBLIC_DEPLOYMENT_MODE=serverless
