EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID
EXPO_PUBLIC_FIREBASE_USE_EMULATORS=0
# These are public Firebase client values, not a service account key.
# Never put private_key, a service-account JSON, or an Admin credential in this file.
