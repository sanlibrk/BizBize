rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function member(cid) {
      return request.auth != null && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/couples/$(cid))
        && firestore.get(/databases/(default)/documents/couples/$(cid)).data.status == 'active'
        && request.auth.uid in firestore.get(/databases/(default)/documents/couples/$(cid)).data.members;
    }
    match /couples/{cid}/{uid}/{file} {
      allow read: if member(cid);
      // Admin uploads avoid Firebase's shareable download-token metadata entirely.
      // Client writes (including reserved token metadata) are always denied.
      allow write: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
