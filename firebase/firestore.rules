rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function member(cid) {
      return verified() && exists(/databases/$(database)/documents/couples/$(cid))
        && get(/databases/$(database)/documents/couples/$(cid)).data.status == 'active'
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(cid)).data.members;
    }
    match /users/{uid} { allow read: if verified() && request.auth.uid == uid; allow write: if false; }
    match /couples/{cid} {
      allow read: if member(cid);
      allow write: if false;
      match /{collection}/{id} {
        allow read: if collection in ['memories','messages','locations'] && member(cid);
        allow write: if false;
      }
    }
    // Membership, invitations, consent and all shared mutations are validated by callable Functions.
    match /{document=**} { allow read, write: if false; }
  }
}
