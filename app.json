{
  "expo": {
    "name": "Biz Bize",
    "slug": "biz-bize",
    "version": "0.1.0",
    "scheme": "bizbize",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.bizbize",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.example.bizbize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Konumunu yalnızca izninle partnerinle paylaşmak ve anılarına yer eklemek için kullanıyoruz.",
          "locationAlwaysAndWhenInUsePermission": "Paylaşım açıkken, uygulama arka plandayken de son konumunu yalnızca partnerinle paylaşmak istiyoruz. Paylaşımı istediğin an kapatabilirsin.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Seçtiğin fotoğrafı yalnızca partnerinle ortak anınıza eklemek için kullanıyoruz.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-router",
      "expo-splash-screen"
    ]
  }
}
