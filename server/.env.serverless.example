# Generate real secrets locally with prepare:serverless; put them in Vercel's private environment settings.
NODE_ENV=production
DEPLOYMENT_MODE=serverless
DATABASE_URL=postgresql://bizbize_api:CHANGE_ME@YOUR_POOLED_NEON_HOST/neondb?sslmode=require
APP_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_BYTES
CRON_SECRET=CHANGE_ME_TO_DIFFERENT_32_RANDOM_BYTES
PUBLIC_URL=https://YOUR_PROJECT.vercel.app
WEB_ORIGINS=https://YOUR_PROJECT.vercel.app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=YOUR_SENDING_ACCOUNT@gmail.com
SMTP_PASS=CHANGE_ME_TO_AN_APP_PASSWORD
MAIL_FROM=YOUR_SENDING_ACCOUNT@gmail.com
PHOTO_MODERATION=manual
