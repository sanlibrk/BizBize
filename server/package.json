{
  "name": "biz-bize-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.serverless.json",
    "admin": "tsx --env-file-if-exists=.env src/admin.ts",
    "prepare:serverless": "tsx --env-file-if-exists=.env.bootstrap src/prepare-serverless.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@vercel/functions": "^3.11.1",
    "fastify": "^5.6.2",
    "nodemailer": "^10.5.0",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
